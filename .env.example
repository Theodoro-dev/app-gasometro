# ---------------------------------------------------------------------
# Gasometro - copie para .env e ajuste.  (cp .env.example .env)
# ---------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Banco (MySQL 8.0.19+). O app nunca fala direto com ele: so a API usa isto.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gasometro
DB_PASSWORD=gasometro
DB_NAME=gas

# Sessao do app
JWT_SECRET=troque-por-uma-string-aleatoria-longa
JWT_EXPIRA_EM=12h

# Regras de negocio (suposicoes do guia, agora explicitas)
LIMITE_CHEIO_PCT=50
LIMITE_BAIXO_PCT=15
HORAS_OFFLINE=2
MARGEM_LEITURA_KG=0.5

# ---------------------------------------------------------------------
# WhatsApp - canal de aviso
#   simulado : nao envia de verdade; registra o aviso e gera link wa.me
#   meta     : WhatsApp Cloud API (Meta)   -> preencha META_PHONE_NUMBER_ID e META_TOKEN
#   twilio   : Twilio WhatsApp API         -> preencha TWILIO_*
# ---------------------------------------------------------------------
WHATSAPP_PROVIDER=simulado
WHATSAPP_REMETENTE=Gasometro

META_API_VERSION=v21.0
META_PHONE_NUMBER_ID=
META_TOKEN=
# Se usar template aprovado, informe o nome; vazio = mensagem de texto livre
META_TEMPLATE=
META_TEMPLATE_IDIOMA=pt_BR

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Worker que varre os alertas pendentes e dispara o aviso
NOTIF_WORKER=true
NOTIF_INTERVALO_SEG=60
NOTIF_MAX_TENTATIVAS=5

# Rotas /api/demo/* (simulador de leituras). Desligue em producao.
DEMO_MODE=true